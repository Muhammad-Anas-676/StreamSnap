rules_version = '2';

// StreamSnap Firestore rules. Paste into Firebase console > Firestore Database > Rules > Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // An admin is a signed-in account that has a document in the "admins" collection (create it by hand in the console).
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function notBanned() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'banned';
    }

    // Each person may only read their own admin document (this is how the admin app checks access).
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // A new account always starts as "active".
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.status == 'active';
      // Users can update their own document but can never change "status"; only an admin can (ban / unban).
      allow update: if signedIn() && (
        (request.auth.uid == uid && request.resource.data.status == resource.data.status) || isAdmin()
      );
      allow delete: if false;
    }

    // One document per link: <uid>_<itemId>
    match /events_links/{id} {
      allow read: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id.matches(request.auth.uid + '_.*')
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 600
        && (!('error' in request.resource.data) || request.resource.data.error.size() <= 2000)
        && notBanned();
      allow delete: if false;
    }

    // One document per screen visit.
    match /events_screens/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.screen is string
        && request.resource.data.durationMs is number
        && notBanned();
      allow update, delete: if false;
    }

    // Errors reported by the app (crashes). Failed downloads are stored on the link document itself.
    match /events_errors/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 6500
        && notBanned();
      allow update, delete: if false;
    }

    // Messages the admin sends to one user. Only the admin creates them; the user may only mark them as delivered.
    match /users/{uid}/notifications/{nid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.message is string && request.resource.data.message.size() <= 600;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['delivered', 'deliveredAt']);
      allow delete: if isAdmin();
    }

    // Announcement banner (text + colour), maintenance and minimum version: everyone signed in can read, only admins can write.
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
