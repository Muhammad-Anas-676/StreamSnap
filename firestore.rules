rules_version = '2';

// StreamSnap Firestore rules (v2.1.0).
// Paste into Firebase console > Firestore Database > Rules > Publish.
//
// Collections: admins, users (+ notifications), events_links, events_screens, events_errors, config.
// Every field the apps write is checked for type and size. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------ helpers
    function signedIn() {
      return request.auth != null;
    }

    // An admin is a signed-in account that has a document in the "admins" collection (create it by hand in the console).
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Reads the user's own document. The app creates it (status "active") before it writes anything else,
    // so a missing document means the write is refused.
    function notBanned() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'banned';
    }

    // Optional-field checks: the field may be missing, but when it is there it must have the right type and size.
    function okStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }
    function okNum(d, k) {
      return !(k in d) || d[k] is number;
    }
    function okBool(d, k) {
      return !(k in d) || d[k] is bool;
    }

    // ------------------------------------------------------------------ admins
    // Each person may only read their own admin document (this is how the admin app checks access).
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ------------------------------------------------------------------ users/{uid}
    function userKeys() {
      return ['uid', 'name', 'email', 'phone', 'country', 'provider', 'createdAt', 'lastActive', 'appVersion',
              'device', 'androidVersion', 'totalDownloads', 'status', 'consentVersion', 'consentAt',
              'isOnline', 'currentActivity'];
    }

    function validUser(d) {
      return okStr(d, 'uid', 128)
        && (!('uid' in d) || d.uid == request.auth.uid)
        && okStr(d, 'name', 200)
        && okStr(d, 'email', 320)
        && okStr(d, 'phone', 40)
        && okStr(d, 'country', 80)
        && okStr(d, 'provider', 20)
        && okNum(d, 'createdAt')
        && okNum(d, 'lastActive')
        && okStr(d, 'appVersion', 40)
        && okStr(d, 'device', 160)
        && okStr(d, 'androidVersion', 80)
        && okNum(d, 'totalDownloads')
        && (!('totalDownloads' in d) || d.totalDownloads >= 0)
        && okStr(d, 'status', 10)
        && okNum(d, 'consentVersion')
        && okNum(d, 'consentAt')
        && okBool(d, 'isOnline')                 // presence: online / offline
        && okStr(d, 'currentActivity', 80);      // presence: what the user is doing
    }

    // The download counter can only go up: a stale or fresh phone can never push a smaller number over the real one.
    function counterNotLowered() {
      return !('totalDownloads' in resource.data)
        || !('totalDownloads' in request.resource.data)
        || request.resource.data.totalDownloads >= resource.data.totalDownloads;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // A new account always starts as "active".
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'active'
        && request.resource.data.keys().hasOnly(userKeys())
        && validUser(request.resource.data);

      // Users can update their own document but can never change "status"; only an admin can (ban / unban).
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userKeys())
          && validUser(request.resource.data)
          && counterNotLowered())
        || isAdmin()
      );

      allow delete: if false;
    }

    // ------------------------------------------------------------------ users/{uid}/notifications/{nid}
    // Messages the admin sends to one user. Only the admin creates them; the user may only mark them as delivered.
    match /users/{uid}/notifications/{nid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'message', 'createdAt', 'delivered', 'from'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.message is string && request.resource.data.message.size() <= 600
        && request.resource.data.createdAt is number
        && request.resource.data.delivered == false
        && okStr(request.resource.data, 'from', 40);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['delivered', 'deliveredAt'])
        && request.resource.data.delivered == true
        && okNum(request.resource.data, 'deliveredAt');
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------ events_links/{uid}_{itemId}
    // One document per link.
    function linkKeys() {
      return ['uid', 'url', 'site', 'status', 'quality', 'addedAt', 'finishedAt', 'error', 'errorType'];
    }

    function validLink(d) {
      return d.uid == request.auth.uid
        && d.url is string && d.url.size() <= 600
        && okStr(d, 'site', 80)
        && d.status in ['added', 'done', 'failed']
        && okStr(d, 'quality', 40)
        && d.addedAt is number
        && okNum(d, 'finishedAt')
        && okStr(d, 'error', 2000)
        && okStr(d, 'errorType', 40);
    }

    match /events_links/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && id.matches(request.auth.uid + '_.*')
        && request.resource.data.keys().hasOnly(linkKeys())
        && validLink(request.resource.data)
        && notBanned();
      allow update: if signedIn()
        && id.matches(request.auth.uid + '_.*')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(linkKeys())
        && validLink(request.resource.data)
        && notBanned();
      allow delete: if false;
    }

    // ------------------------------------------------------------------ events_screens/{auto id}
    // One document per screen visit.
    match /events_screens/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'screen', 'startAt', 'durationMs'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.screen is string && request.resource.data.screen.size() <= 40
        && request.resource.data.startAt is number
        && request.resource.data.durationMs is number
        && request.resource.data.durationMs >= 0
        && request.resource.data.durationMs <= 86400000
        && notBanned();
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------ events_errors/{auto id}
    // Errors reported by the app (crashes). Failed downloads are stored on the link document itself.
    match /events_errors/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'type', 'message', 'detail', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type is string && request.resource.data.type.size() <= 40
        && request.resource.data.message is string && request.resource.data.message.size() <= 400
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 6500
        && request.resource.data.at is number
        && notBanned();
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------ config/app
    // Announcement banner (text + colour), maintenance and minimum version:
    // everyone signed in can read, only admins can write the "app" document.
    function validConfig(d) {
      return d.keys().hasOnly(['maintenance', 'announcement', 'announcementId', 'minVersionCode', 'announcementColor'])
        && d.maintenance is bool
        && d.announcement is string && d.announcement.size() <= 300
        && d.announcementId is number
        && d.minVersionCode is number && d.minVersionCode >= 0
        && d.announcementColor is string && d.announcementColor.size() <= 30;
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && doc == 'app' && validConfig(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
